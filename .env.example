# Postgres — отдельная БД самого Node-backend'а (не шарится с iRidium-сервером:
# у него теперь своя встроенная SQLite). Схема auth оставлена как логическое
# пространство имён на будущее, изолировать её больше не от кого.
DATABASE_URL=postgres://user:password@localhost:5432/kanada

# Порт, на котором слушает Node (за Caddy/reverse proxy в проде)
PORT=3001

# Сколько реверс-прокси хопов реально стоит перед Node (для express "trust proxy" —
# от этого зависит req.ip в rate-limit'е и audit-логе). 1 = один Caddy перед Node.
# Если добавится ещё один хоп (CDN, балансировщик) — поднять соответственно, иначе
# X-Forwarded-For можно подделать и обойти rate limit.
TRUST_PROXY_HOPS=1

# Секрет для сессионных cookie (session id подписывается, чтобы подделка была видна сразу,
# сама сессия всё равно проверяется по хэшу токена в БД, см. Phase 1 плана)
COOKIE_SECRET=change-me-to-a-long-random-string

# Разрешённый Origin для CORS и (в Phase 4) для проверки WS-апгрейда
WEB_CLIENT_ORIGIN=http://localhost:5173

# Ключ шифрования TOTP-секретов at rest (AES-256-GCM) — 32 байта в hex (64 символа).
# Сгенерировать: openssl rand -hex 32   (или node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Хранить только в env, не в БД — иначе дамп Postgres сам по себе отдаёт рабочие 2FA-секреты.
TOTP_ENCRYPTION_KEY=

# Rate limit на /auth/login и /auth/2fa/verify|recovery (попыток за окно, с одного IP;
# у каждого эндпоинта свой независимый счётчик, но конфиг общий). Дефолт (10/15 мин)
# рассчитан на прод. При активном ручном тестировании удобнее раскомментировать и
# поднять — не забыть вернуть перед тем, как открывать наружу.
# RATE_LIMIT=1000
# RATE_LIMIT_WINDOW_MS=60000

# WS-мост к iRidium-серверу (см. WsGatewayService, Phase 4 плана) - сейчас
# это тестовый мост, адрес/протокол не финализированы.
IRIDI_SERVER=ws://iridium-host:8090

NODE_ENV=development
